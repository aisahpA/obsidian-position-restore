{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2021",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    // 不写 `baseUrl`：TS 6 起弃用、TS 7 移除。这些目标现在相对**本文件**解析，
    // 所以继承它的 `tests/tsconfig.json` 仍然指向 src/，而不是 tests/src/。
    "paths": {
      "@/*": ["./src/*"]
    },
    "importHelpers": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSourceMap": false,
    "inlineSources": false,
    "lib": ["dom", "es2021"]
  },
  "include": ["**/*.ts"],
  "exclude": ["tests"]
}
