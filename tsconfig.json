{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2021",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    // No `baseUrl`: deprecated in TS 6 and gone in 7. These targets are now
    // relative to THIS file, so `tests/tsconfig.json` (which extends it) keeps
    // pointing at src/ and not at tests/src/.
    "paths": {
      "@/*": ["./src/*"]
    },
    "importHelpers": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSourceMap": false,
    "inlineSources": false,
    "lib": ["dom", "es2021"]
  },
  "include": ["**/*.ts"],
  "exclude": ["tests"]
}
