{
  "name": "obsidian-position-restore",
  "version": "1.2.0",
  "description": "Restore cursor and scroll position for each note across sessions and devices — exact landing, no jump.",
  "main": "main.js",
  "scripts": {
    "dev": "rollup --config rollup.config.mjs -w",
    "build": "rollup --config rollup.config.mjs --environment PROD:1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "reload": "bash reload.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.2",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "obsidian": "latest",
    "rollup": "^4.63.1",
    "tslib": "^2.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
